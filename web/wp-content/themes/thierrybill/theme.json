{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Weiss", "color": "#f5f5f3" },
				{ "slug": "surface", "name": "Hellgrau", "color": "#e8e8e5" },
				{ "slug": "line", "name": "Linie", "color": "#d9d9d5" },
				{ "slug": "muted", "name": "Grau", "color": "#6b6b68" },
				{ "slug": "contrast", "name": "Schwarz", "color": "#111111" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1680px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.25rem, 2vw, 1.75rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(2rem, 4vw, 3.5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(3.5rem, 8vw, 7rem)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(5rem, 12vw, 11rem)" }
			],
			"units": [ "px", "rem", "em", "%", "vh", "vw" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "display",
					"name": "Ballet",
					"fontFamily": "Ballet, 'Snell Roundhand', cursive",
					"fontFace": [
						{
							"fontFamily": "Ballet",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ballet-latin.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.6875rem", "fluid": false },
				{ "slug": "s", "name": "S", "size": "0.875rem", "fluid": false },
				{ "slug": "m", "name": "M", "size": "0.9375rem", "fluid": false },
				{ "slug": "l", "name": "L", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "2.125rem" } },
				{ "slug": "xl", "name": "XL", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "3rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1rem",
			"padding": {
				"left": "clamp(1rem, 2.2vw, 2.25rem)",
				"right": "clamp(1rem, 2.2vw, 2.25rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|s",
			"fontWeight": "400",
			"lineHeight": "1.45",
			"letterSpacing": "-0.006em"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } },
				":focus-visible": { "outline": { "color": "var:preset|color|contrast", "style": "solid", "width": "1px", "offset": "3px" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "500",
					"lineHeight": "1.3",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|s" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|s" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|s" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|s" } },
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" },
				"border": { "radius": "0" },
				"typography": { "fontSize": "var:preset|font-size|s", "fontWeight": "500" },
				"spacing": { "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.2rem", "right": "1.2rem" } },
				":hover": { "color": { "background": "var:preset|color|muted" } }
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|xs" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|s", "fontWeight": "400" }
			},
			"core/site-title": {
				"typography": { "fontSize": "var:preset|font-size|s", "fontWeight": "500" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|line" },
				"border": { "width": "1px 0 0 0" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Seite ohne Titel (Raster)", "postTypes": [ "page" ] }
	]
}
